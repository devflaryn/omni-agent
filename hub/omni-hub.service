[Unit]
Description=Omni hub: accounts, device logs and routing of encrypted frames, on https://tomcamp.tech/
After=network-online.target
Wants=network-online.target

[Service]
Environment=OMNI_HUB_PORT=443 OMNI_HUB_DATA=/var/lib/omni-hub OMNI_HUB_ORIGIN=https://tomcamp.tech
Environment=OMNI_HUB_CERT=%d/fullchain.pem OMNI_HUB_KEY=%d/privkey.pem
# Holds OMNI_HUB_BOOTSTRAP_TOKEN. Root-only: systemd reads it before it drops to the throwaway user.
EnvironmentFile=/etc/omni-hub/bootstrap.env
# systemd reads these as root and hands the service a private copy, so the certbot folders stay root-only.
LoadCredential=fullchain.pem:/etc/letsencrypt/live/tomcamp.tech/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/tomcamp.tech/privkey.pem
ExecStart=/usr/bin/node /opt/omni-hub/hub/server.mjs
Restart=always
RestartSec=2
# A throwaway unprivileged user and a read-only view of the system, except its own state directory.
DynamicUser=yes
StateDirectory=omni-hub
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# V8 compiles to memory it then runs, so this stays off.
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
