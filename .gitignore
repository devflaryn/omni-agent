# Agent/tooling config
.claude/
.opencode/

# Python
__pycache__/
*.py[cod]

# Graphify output
graphify-out/

# LLM provider config (contains API keys)
llm_config.json

# omnidroid emulator service — runtime state bootstrapped next to the exe
# (keep tools/omnidroid/omnidroid.exe + HOWTO.md tracked; ignore the rest)
tools/omnidroid/configs/
tools/omnidroid/accounts/
tools/omnidroid/qemu/
tools/omnidroid/runtime/
tools/omnidroid/instances/
# QEMU disk images are never committed (see tools/omnidroid/HOWTO.md §9/§10)
*.qcow2

# Keep the folders, ignore their contents
workspace/*
!workspace/.gitkeep
memory/*
!memory/.gitkeep

# Runtime: last-used/recent picked workspace folders (Part 2 redesign)
agent_workspaces.json

# Test fixtures: large APK binaries are NOT committed (see test-assets/README.md)
test-assets/*.apk

# Local test scripts remain ignored, except maintained engine regressions.
/tests/*
!/tests/test_headless_engine.py
!/tests/test_working_copy.py
!/tests/test_llm_streaming.py
!/tests/frontend/
/tests/frontend/*
!/tests/frontend/test_live_streaming.mjs
!/tests/frontend/preview_bridge.js
!/tests/frontend/preview_server.py

# ── Additional local state / junk ──────────────────────────────
# Agent/tooling scratch (extra assistants + probe dirs)
.codex/
.agents/
.test-memory-probe/
# Editors / IDEs
.vscode/
.idea/
# Python envs & caches
.venv/
venv/
.pytest_cache/

# Subagent-driven-development scratch (ledger, task briefs/reports)
.superpowers/
.mypy_cache/
.ruff_cache/
# Local env / secrets (llm_config.json already covered above)
.env
.env.*
# Temp scratch dirs the sandbox creates next to the agent + stray run logs
/tmp*/
launch_out.txt
*.log
# OS noise
.DS_Store
Thumbs.db
desktop.ini

# git worktrees for isolated task execution
.worktrees/
